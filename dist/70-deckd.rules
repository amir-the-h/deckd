# Lets the logged-in user open Elgato decks without root.
# hidraw for normal use; usb so deckd can reset a deck another app left detached.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0fd9", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fd9", TAG+="uaccess"
# Auto-click and the MangoHud key fallback inject input through virtual devices.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
